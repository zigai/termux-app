<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="keyboard"
        app:title="@string/termux_keyboard_header">

        <ListPreference
            app:key="terminal_input_provider"
            app:defaultValue="built_in"
            app:entries="@array/termux_terminal_input_provider_entries"
            app:entryValues="@array/termux_terminal_input_provider_values"
            app:summary="%s"
            app:title="@string/termux_terminal_input_provider_title" />

        <SeekBarPreference
            app:key="landscape_keyboard_width_percent"
            app:defaultValue="18"
            app:min="12"
            android:max="20"
            app:showSeekBarValue="true"
            app:summary="@string/termux_landscape_keyboard_width_summary"
            app:title="@string/termux_landscape_keyboard_width_title" />

        <ListPreference
            app:key="speech_provider"
            app:defaultValue="automatic"
            app:entries="@array/termux_speech_provider_entries"
            app:entryValues="@array/termux_speech_provider_values"
            app:summary="%s"
            app:title="@string/termux_speech_provider_title" />

        <EditTextPreference
            app:key="speech_language"
            app:defaultValue=""
            app:dialogMessage="@string/termux_speech_language_dialog"
            app:summary="@string/termux_speech_language_summary"
            app:title="@string/termux_speech_language_title" />

        <Preference
            app:key="speech_input_diagnostics"
            app:selectable="false"
            app:title="@string/termux_speech_diagnostics_title" />

        <Preference
            app:key="reload_built_in_keyboard"
            app:summary="@string/termux_reload_built_in_keyboard_summary"
            app:title="@string/termux_reload_built_in_keyboard_title" />

        <Preference
            app:key="built_in_keyboard_diagnostics"
            app:selectable="false"
            app:title="@string/termux_built_in_keyboard_diagnostics_title" />

        <SwitchPreferenceCompat
            app:key="soft_keyboard_enabled"
            app:summaryOff="@string/termux_soft_keyboard_enabled_off"
            app:summaryOn="@string/termux_soft_keyboard_enabled_on"
            app:title="@string/termux_soft_keyboard_enabled_title" />

        <SwitchPreferenceCompat
            app:key="soft_keyboard_enabled_only_if_no_hardware"
            app:summaryOff="@string/termux_soft_keyboard_enabled_only_if_no_hardware_off"
            app:summaryOn="@string/termux_soft_keyboard_enabled_only_if_no_hardware_on"
            app:title="@string/termux_soft_keyboard_enabled_only_if_no_hardware_title" />

    </PreferenceCategory>

</PreferenceScreen>
