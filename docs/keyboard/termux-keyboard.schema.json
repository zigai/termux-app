{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zigai/termux-app/master/docs/keyboard/termux-keyboard.schema.json",
  "title": "Termux built-in terminal keyboard configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultProfile", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "defaultProfile": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|terminalForeground|terminalBackground)$"
    },
    "fontFamily": {
      "enum": ["system", "sans", "sansMedium", "monospace", "terminal"]
    },
    "fontWeight": {
      "enum": ["normal", "medium", "bold"]
    },
    "icon": {
      "enum": [
        "shift",
        "backspace",
        "enter",
        "microphone",
        "tab",
        "space",
        "arrowUp",
        "arrowDown",
        "arrowLeft",
        "arrowRight"
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "$ref": "#/$defs/color" },
        "borderColor": { "$ref": "#/$defs/color" },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 8 },
        "primaryColor": { "$ref": "#/$defs/color" },
        "secondaryColor": { "$ref": "#/$defs/color" },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 32 },
        "textSize": { "type": "number", "minimum": 8, "maximum": 32 },
        "iconSize": { "type": "number", "minimum": 12, "maximum": 40 },
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "fontWeight": { "$ref": "#/$defs/fontWeight" }
      }
    },
    "layoutStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "$ref": "#/$defs/color" },
        "borderColor": { "$ref": "#/$defs/color" },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 8 },
        "primaryColor": { "$ref": "#/$defs/color" },
        "secondaryColor": { "$ref": "#/$defs/color" },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 32 },
        "textSize": { "type": "number", "minimum": 8, "maximum": 32 },
        "iconSize": { "type": "number", "minimum": 12, "maximum": 40 },
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "fontWeight": { "$ref": "#/$defs/fontWeight" },
        "horizontalGap": { "type": "number", "minimum": 0, "maximum": 24 },
        "verticalGap": { "type": "number", "minimum": 0, "maximum": 24 },
        "horizontalPadding": { "type": "number", "minimum": 0, "maximum": 32 },
        "verticalPadding": { "type": "number", "minimum": 0, "maximum": 32 },
        "secondaryTextScale": { "type": "number", "minimum": 0.35, "maximum": 1 },
        "verticalAlignment": { "enum": ["top", "center", "bottom"] }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "$ref": "#/$defs/color" },
        "borderColor": { "$ref": "#/$defs/color" },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 8 },
        "primaryColor": { "$ref": "#/$defs/color" },
        "secondaryColor": { "$ref": "#/$defs/color" },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 32 },
        "textSize": { "type": "number", "minimum": 8, "maximum": 32 },
        "iconSize": { "type": "number", "minimum": 12, "maximum": 40 },
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "fontWeight": { "$ref": "#/$defs/fontWeight" },
        "horizontalGap": { "type": "number", "minimum": 0, "maximum": 24 },
        "verticalGap": { "type": "number", "minimum": 0, "maximum": 24 },
        "horizontalPadding": { "type": "number", "minimum": 0, "maximum": 32 },
        "verticalPadding": { "type": "number", "minimum": 0, "maximum": 32 },
        "secondaryTextScale": { "type": "number", "minimum": 0.35, "maximum": 1 },
        "verticalAlignment": { "enum": ["top", "center", "bottom"] },
        "background": { "$ref": "#/$defs/color" },
        "pressedFill": { "$ref": "#/$defs/color" },
        "armedFill": { "$ref": "#/$defs/color" },
        "lockedFill": { "$ref": "#/$defs/color" },
        "preview": { "type": "boolean" },
        "haptics": { "type": "boolean" },
        "sound": { "type": "boolean" },
        "repeatDelayMs": { "type": "integer", "minimum": 250, "maximum": 1000 },
        "repeatIntervalMs": { "type": "integer", "minimum": 25, "maximum": 250 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "terminalKey", "modifier", "layer", "macro", "app", "profile", "delay"] },
        "text": { "type": "string" },
        "key": {
          "enum": [
            "ENTER", "ESCAPE", "TAB", "BACKSPACE", "UP", "DOWN", "LEFT", "RIGHT",
            "HOME", "END", "PAGE_UP", "PAGE_DOWN", "INSERT", "DELETE",
            "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12"
          ]
        },
        "modifier": { "enum": ["CTRL", "ALT", "SHIFT"] },
        "layer": { "type": "string" },
        "mode": { "enum": ["momentary", "once", "locked", "smart"] },
        "macro": { "type": "string" },
        "app": { "enum": ["paste", "drawer", "hideKeyboard", "speechInput"] },
        "profile": { "type": "string" },
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["CTRL", "ALT", "SHIFT"] }
        },
        "delayMs": { "type": "integer", "minimum": 0, "maximum": 2000 }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "action"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "icon": { "$ref": "#/$defs/icon" },
        "secondaryLabel": { "type": "string" },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["id", "label"] },
        { "required": ["id", "icon", "accessibilityLabel"] },
        { "properties": { "spacer": { "const": true } }, "required": ["spacer"] }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "icon": { "$ref": "#/$defs/icon" },
        "secondaryLabel": { "type": "string" },
        "accessibilityLabel": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "spacer": { "type": "boolean" },
        "styleClass": { "type": "string" },
        "style": { "$ref": "#/$defs/style" },
        "repeat": { "type": "boolean" },
        "cursorGesture": { "type": "boolean" },
        "preview": { "type": "boolean" },
        "action": { "$ref": "#/$defs/action" },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/alternative" }
        },
        "layers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/override" }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "offset": { "type": "number", "minimum": 0 },
        "endOffset": { "type": "number", "minimum": 0 },
        "horizontalGap": { "type": "number", "minimum": 0, "maximum": 24 },
        "verticalGap": { "type": "number", "minimum": 0, "maximum": 24 },
        "height": { "type": "number", "minimum": 24, "maximum": 96 },
        "keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } }
      }
    },
    "rail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "utilityRail": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "landscapeSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "dependentRequired": {
        "leftUtility": ["rightUtility"],
        "rightUtility": ["leftUtility"]
      },
      "properties": {
        "railWidthPercent": { "type": "number", "minimum": 12, "maximum": 20, "default": 18, "description": "Requested width of each rail. Runtime also caps each rail at 20% so the terminal retains at least 60%." },
        "railMinWidthDp": { "type": "number", "minimum": 48, "maximum": 120, "default": 72, "description": "Preferred touch-width floor; it never overrides the 20% rail safety cap." },
        "maxHeightDp": { "type": "number", "minimum": 240, "maximum": 720, "default": 520 },
        "rowHeightDp": { "type": "number", "minimum": 24, "maximum": 96, "default": 36 },
        "utilityRowHeightDp": { "type": "number", "minimum": 24, "maximum": 48, "default": 24, "description": "Height shared by the optional paired utility headers." },
        "appearance": { "$ref": "#/$defs/layoutStyle" },
        "leftUtility": { "$ref": "#/$defs/utilityRail" },
        "rightUtility": { "$ref": "#/$defs/utilityRail" },
        "left": { "$ref": "#/$defs/rail" },
        "right": { "$ref": "#/$defs/rail" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minWidthDp", "rowHeightDp", "rows"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "minWidthDp": { "type": "number", "minimum": 0 },
        "maxWidthDp": { "type": "number", "exclusiveMinimum": 0 },
        "rowHeightDp": { "type": "number", "minimum": 24, "maximum": 96 },
        "appearance": { "$ref": "#/$defs/layoutStyle" },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } },
        "landscapeSplit": { "$ref": "#/$defs/landscapeSplit" }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "label": { "type": "string" } }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "styles", "macros", "layers", "variants"],
      "properties": {
        "theme": { "$ref": "#/$defs/theme" },
        "styles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/style" } },
        "macros": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "$ref": "#/$defs/action" }
          }
        },
        "layers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layer" } },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } }
      }
    }
  }
}
